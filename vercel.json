{
  "cleanUrls": true,
  "headers": [
    { "source": "/video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/video/playlist.txt", "headers": [{ "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }, { "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
